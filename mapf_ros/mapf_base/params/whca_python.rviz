      Enabled: true
      Name: Robot Markers
      Namespaces:
        labels: true
        robots: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mapf/robot_markers
